# ── Sanity.io (valores PÚBLICOS — seguros para el frontend Nuxt) ─────────────
# Leídos por @nuxtjs/sanity para hacer consultas GROQ desde el cliente/servidor.
NUXT_PUBLIC_SANITY_PROJECT_ID=rbrk7xv9
NUXT_PUBLIC_SANITY_DATASET=production

# ── Sanity.io (valores para Sanity Studio — carpeta /sanity) ─────────────────
# Leídos por sanity.config.ts y sanity.cli.ts al arrancar el Studio.
# En local: apunta a "staging". En CI/producción: se inyectan como secrets.
SANITY_STUDIO_PROJECT_ID=rbrk7xv9
SANITY_STUDIO_DATASET=staging

# ── Sanity.io (valores PRIVADOS — solo funciones Go en Vercel) ───────────────
# NUNCA exponer al frontend ni commitear este valor.
# Obtener desde: https://sanity.io/manage → tu proyecto → API → Tokens
SANITY_WRITE_TOKEN=

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Secreto compartido entre Sanity y el handler Go /api/webhook/rebuild.
# Generar con: openssl rand -hex 32
SANITY_WEBHOOK_SECRET=

# ── Autenticación del Administrador ──────────────────────────────────────────
# Hash bcrypt de la contraseña del administrador del Studio.
# Generar con: htpasswd -bnBC 10 "" TU_CONTRASEÑA | tr -d ':\n'
ADMIN_PASSWORD_HASH=
# Secreto para firmar JWT — string larga y aleatoria.
# Generar con: openssl rand -hex 64
ADMIN_JWT_SECRET=

# ── Anti-bot (opcional) ───────────────────────────────────────────────────────
CAPTCHA_SECRET_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# En producción: https://lectorpobre.com
# En desarrollo: http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# ── Analítica (opcional) ──────────────────────────────────────────────────────
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=lectorpobre.com
